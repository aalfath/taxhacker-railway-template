{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	# Health check for Railway: answers without login, and only once TaxHacker itself is up.
	@health path /healthz
	handle @health {
		rewrite * /favicon-32x32.png
		reverse_proxy 127.0.0.1:7331
	}

	handle {
		basic_auth {
			{$TAXHACKER_USERNAME} {$TAXHACKER_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:7331
	}
}
